        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.showInstalledIoModules', 'TargetName')"], "purpose":"Defined target names"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  },
  "speedgoat.getIoInterfaces":
  {
     "inputs":
     [
        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.getIoInterfaces', 'TargetName')"], "purpose":"Defined target names"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"},
        {"name":"Advanced", "kind":"namevalue", "type":["logical","scalar"],"purpose":"Option"}
     ]
  },
  "speedgoat.showPtpInterfaces":
