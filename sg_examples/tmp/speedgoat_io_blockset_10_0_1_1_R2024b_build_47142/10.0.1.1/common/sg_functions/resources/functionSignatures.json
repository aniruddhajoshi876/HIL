        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  },
  "speedgoat.IpAliasConfiguration":
  {
     "inputs":
     [
        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.IpAliasConfiguration')"], "purpose":"Target Name available"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  },
  "speedgoat.License":
  {
     "inputs":
     [
        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.License')"], "purpose":"Target Name available"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
