  "speedgoat.setDefaultBootOption":
  {
     "inputs":
     [
        {"name":"release", "kind":"required", "type":["choices=sg.public.getJsonList('speedgoat.setDefaultBootOption', 'Release')"],"purpose":"E.g., current release"},
        {"name":"DualBootTimeout", "kind":"namevalue", "type":["numeric"],"purpose":"Dual Boot Timeout [s]"},
