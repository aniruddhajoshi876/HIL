        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.setDefaultBootOption', 'TargetName')"], "purpose":"Target Name available"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  },
  "speedgoat.setTargetTime":
  {
     "inputs":
     [
        {"name":"newTime", "kind":"required", "type":["numeric"],"purpose":"Value [datenum]"},
        {"name":"TargetName", "kind":"namevalue", "type":["choices=sg.public.getJsonList('speedgoat.setTargetTime')"], "purpose":"Target Name available"},
        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  },
  "speedgoat.showBitstreamContent":
  {
     "inputs":
