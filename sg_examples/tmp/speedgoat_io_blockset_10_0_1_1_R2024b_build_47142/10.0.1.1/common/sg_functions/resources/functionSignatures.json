        {"name":"TargetObject", "kind":"namevalue", "type":["slrealtime.Target"], "purpose":"Target Object type (slrealtime.Target)"}
     ]
  }, 
  "speedgoat.doc":
  {
     "inputs":
     [
        {"name":"docPage", "kind":"ordered", "type":["choices=sg.public.getJsonList('speedgoat.doc')"], "purpose":"Doc page available"}
     ]
  }, 
  "speedgoat.model.createFromSycon":
  {
     "inputs":
     [
        {"name":"fileName", "kind":"required", "type":["char"], "purpose":"Sycon config file name"},
        {"name":"ShowStatusSignals", "kind":"namevalue", "type":["logical","scalar"],"purpose":"Option"}
     ]
  },
  "speedgoat.model.highlight":
  {
     "inputs":
     [
        {"name":"path", "kind":"required", "type":["char"], "purpose":"Specifiy path to object to highlight"},
        {"name":"Open", "kind":"namevalue", "type":["logical","scalar"],"purpose":"Open path?"},
		{"name":"Parameter", "kind":"namevalue", "type":["char"],"purpose":"Name of parameter in blockmask"},
		{"name":"Signal", "kind":"namevalue", "type":["double"],"purpose":"Signal port number"}
     ]
  },
  "speedgoat.uninstall":
  {
     "inputs":
     [
        {"name":"Force", "kind":"namevalue", "type":["logical","scalar"],"purpose":"Option"}
     ]
  }

