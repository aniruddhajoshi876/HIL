%implements sg_mqtt_client_subscribe_s "C"

%include "sg_mqtt.tlc"

%<MqttCommonIncludes()>

%% =================================================================================================
%function Start(block, system) Output

    %with block.SFcnParamSettings[0]

    {
        int32_t ret = 0;
        mqtt::cClientStation* Station = NULL;
        mqtt::cClientConnection *Connection = NULL;
        mqtt::cClientTransceiver *Transceiver = NULL;

        %assign MaxDataLen = LibGetDataTypeSLSizeFromId(LibBlockDWorkDataTypeId(Buffer)) * LibBlockDWorkWidth(Buffer)
        %<LibBlockDWorkDataTypeName(Buffer, "")> InitValue[%<LibBlockDWorkWidth(Buffer)>] = 
            %assign value = GENERATE_FORMATTED_VALUE(InitValue, "", TLC_FALSE) 
            ;

        /* Add one client station */
        ret = mqtt::Root.addStation(%<ClientId>, MQTT_STATION_TYPE_CLIENT, (mqtt::cStation**)&Station);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Adding MQTT client station %i failed!", %<ClientId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Add one connection to the station */
        ret = Station->addConnection(%<ConnectionId>, (mqtt::cClientConnection**)&Connection);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Adding MQTT connection %i to client %i failed!", %<ClientId>, %<ConnectionId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Add one transceiver to the connection */
        ret = Connection->addTransceiver((mqtt::cClientTransceiver**)&Transceiver);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Adding MQTT subscribe block to client %i connection %i failed!", %<ClientId>, %<ConnectionId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Initialize the transceiver */
        ret = Transceiver->init(MQTT_BLOCK_TYPE_CLIENT_SUBSCRIBE, (char*)"%<Topic>", %<QoS>, 0, (uint8_T*)%<LibBlockDWorkAddr(Buffer,"","",0)>, %<MaxDataLen>);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Initializing MQTT client subscribe block failed!");
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Copy init values to output ports */
        %if LibBlockOutputSignalConnected(0)
            memcpy(%<LibBlockOutputSignalAddr(0, "", "", 0)>, \
                InitValue, \
                %<MaxDataLen>);  
        %endif
        %if Extended
            %if LibBlockOutputSignalConnected(2)
                %<LibBlockOutputSignal(2, "", "", 0)> = %<MaxDataLen>;
            %endif
        %endif

        /* Write the block address to PWork */
        %<LibBlockPWork(Instance, "", "", 0)> = Transceiver;
    }

    %endwith

%endfunction

%% =================================================================================================
%function Outputs(block, system) Output

    %with block.SFcnParamSettings[0]

    %assign MaxDataLen = LibGetDataTypeSLSizeFromId(LibBlockDWorkDataTypeId(Buffer)) * LibBlockDWorkWidth(Buffer)

    {
        mqtt::cClientTransceiver* Transceiver = (mqtt::cClientTransceiver*)%<LibBlockPWork(Instance, "", "", 0)>;
        uint32_t DevFlagsRx = Transceiver->DevFlagsRx;

        if (DevFlagsRx != Transceiver->HostFlagsRx)
        {
            %if LibBlockOutputSignalConnected(0)
                memset(%<LibBlockOutputSignalAddr(0, "", "", 0)>, 0, %<MaxDataLen>);
                memcpy(%<LibBlockOutputSignalAddr(0, "", "", 0)>, \
                        %<LibBlockDWorkAddr(Buffer,"","",0)>, \
                        Transceiver->DataLen);
            %endif
            %if Extended
                %if LibBlockOutputSignalConnected(1)
                    %<LibBlockOutputSignal(1, "", "", 0)> = DevFlagsRx; 
                %endif
                %if LibBlockOutputSignalConnected(2)
                    %<LibBlockOutputSignal(2, "", "", 0)> = Transceiver->DataLen;
                %endif
            %endif
            Transceiver->HostFlagsRx = DevFlagsRx;
        }
    }

    %endwith

%endfunction

%% =================================================================================================
%function Terminate(block, system) Output
%endfunction
