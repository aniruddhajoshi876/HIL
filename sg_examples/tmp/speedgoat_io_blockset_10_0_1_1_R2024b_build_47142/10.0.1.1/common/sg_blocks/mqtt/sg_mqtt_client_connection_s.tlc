%implements sg_mqtt_client_connection_s "C"

%include "sg_mqtt.tlc"

%<MqttCommonIncludes()>

%% =================================================================================================
%function Start(block, system) Output

    %with block.SFcnParamSettings

    {
        int32_t ret = 0;
        mqtt::cClientStation *Station = NULL;
        mqtt::cClientConnection *Connection = NULL;

        /* Add one client station */
        ret = mqtt::Root.addStation(%<StationId>, MQTT_STATION_TYPE_CLIENT, (mqtt::cStation**)&Station);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Adding MQTT client station %i failed!", %<StationId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Add one connection */
        ret = Station->addConnection(%<ConnectionId>, (mqtt::cClientConnection**)&Connection);
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Adding MQTT connection %i to client %i failed!", %<StationId>, %<ConnectionId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Initialize the connection */
        ret = Connection->init(%<IpAddr>, %<TcpPort>, %<UserAuth>, (char*)"%<Username>", (char*)"%<Password>");
        if (ret != 0)
        {
            sprintf(pSgErrorStr, "Initializing MQTT connection %i failed!", %<ConnectionId>);
            %<LibSetRTModelErrorStatus("pSgErrorStr")>;
            return;
        }

        /* Write the connection address to PWork */
        %<LibBlockPWork(Instance, "", "", 0)> = Connection;
    }

    %endwith

%endfunction

%% =================================================================================================
%function Outputs(block, system) Output

    %with block.SFcnParamSettings
    
    {
        mqtt::cClientConnection* Connection = (mqtt::cClientConnection*)%<LibBlockPWork(Instance, "", "", 0)>;
        %<LibBlockOutputSignal(0, "", "", 0)> = Connection->IsCom;
    }

    %endwith

%endfunction

%% =================================================================================================
%function Terminate(block, system) Output
    
    %<MqttTerminate(block)>

%endfunction
