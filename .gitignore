# Inverter HIL generated products (source .slx/.sldd/.m files stay tracked)
.simulink/
slprj/
*.slxc
*_sg_rtw/
*_grt_rtw/
*_ert_rtw/
build/inverter_hil/
logs/inverter_hil/
examples/10.0.1.1/
examples/tmp/
*.mldatx

# Decision-16 spike products; regenerate with build_decision16_spike(true)
spikes/decision16/decision16_spike.slx
spikes/decision16/decision16_spike.sldd

# ---------------------------------------------------------------------------
# Added 2026-08-02 with the initial commit
# ---------------------------------------------------------------------------
# examples/ totals ~2.0 GB (vendor blockset + Speedgoat example projects) and
# is reinstallable from the Speedgoat Customer Portal. The two rules above
# cover the bulk of it; this excludes the remainder so no vendor payload can
# reach the remote.
examples/

# The Speedgoat I/O blockset installer (~251 MB) ships inside Speedgoat.zip.
# references/ keeps only the manuals and wiring diagrams; the installer and the
# original archive stay out of git (GitHub rejects >100 MB blobs without LFS).
speedgoat_io_blockset_*.zip
Speedgoat.zip

# Further MATLAB generated products not covered above
codegen/
*.asv
*.autosave
*.mexw64
*.mexa64

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store

# CM4SL build outputs (regenerable from the .vcxproj / Makefile)
carmaker/FS_race/src_cm4sl/Release/
carmaker/FS_race/src_cm4sl/*.o
carmaker/FS_race/src_cm4sl/.depend
carmaker/FS_race/src_cm4sl/libcarmaker4sl.mexw64

# The blanket examples/ rule above (aimed at the ~2 GB vendor blockset) also
# matched CarMaker's own Data/*/Examples/ folders case-insensitively on
# Windows, silently dropping 40 project data files -- including the tire
# CONTINENTAL_FS_205_510_R13_80kPa that MFE24_V3 needs, which aborted
# SIM_START with "Tire: Can't read file".
!carmaker/**/Examples/
!carmaker/**/Examples/**
