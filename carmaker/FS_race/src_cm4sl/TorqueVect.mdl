<?xml version="1.0" encoding="utf-8"?>
<chart id="135">
  <P Name="name">CarMaker/IPG Vehicle/PowerTrain/PTControl Example/PTControl_ALL_CTRL_VC_REGEN/Subsystem1/TorqueSplit/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">135</P>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">135</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [fl_out, fr_out, rl_out, rr_out]= fcn(f_in, r_in, maxTrq)

front = f_in * 0.5;
rear = r_in * 0.5;

%% Convert for regen
if f_in &lt; 0
    front = front * -1;
    rear = rear * -1;
end

%% Check for &gt; maxTrq
if front &gt; maxTrq &amp;&amp; rear &gt; maxTrq
    front = maxTrq;
    rear = maxTrq;
elseif front &gt; maxTrq
    rear = rear + (front-maxTrq);
    front = maxTrq;
elseif rear &gt; maxTrq
    front = front + (rear-maxTrq);
    rear = maxTrq;
end

%% Convert back for regen
if f_in &lt; 0
    front = front * -1;
    rear = rear * -1;
end

fl_out = front;
fr_out = front;
rl_out = rear;
rr_out = rear;</P>
      </eml>
    </state>
    <data SSID="4" name="f_in">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
