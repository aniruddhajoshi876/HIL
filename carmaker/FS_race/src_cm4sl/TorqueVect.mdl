<?xml version="1.0" encoding="utf-8"?>
<chart id="69">
  <P Name="name">CarMaker/IPG Vehicle/PowerTrain/PTControl Example/PTControl_TV_MFE3/Full Control Loop/Torque Allocation</P>
  <P Name="windowPosition">[563 52 198 683]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">69</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">69</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [u1, u2, u3, u4] = fcn(F, u, omega, P_max, T_i_max, lamda)
    n       = 4;            % four wheels
    %P_max   = 80000;          % W, power cap
    %T_i_max = 21;           % Nm, max torque of each wheel
    T_max   = n * T_i_max;  % Total max torque

    % If we have any negative or zero value, the objective becomes ill
    % defined, add check 
    % If load on tire is smaller than 100, assume wrong and set to standard
    % value of 500
    F(F &lt; 100) = 500;
      

    % Define cost function
    F_total = sum(F);

    w = sqrt(F_total ./ F);
    D = diag(w);                % Weighted penalty matrix
    A = ones(1, n);             % Converted torque equality constraint
    b = u * T_max;
    %lamda = 0.5;                % Scaling factor

    fun = @(x) norm(b - A*x) + lamda*norm(D*x);

    % Define inequality constraints to satisfy power cap
    A_ineq = omega*13.39;
    b_ineq = P_max;

   
    % Define bounds on solution, x = [4x1]
    ub = T_i_max * ones(n, 1);
    lb = zeros(n, 1);

    % Solve the optimization problem
    x0 = zeros(n, 1);
    opts = optimoptions(&apos;fmincon&apos;,&apos;Algorithm&apos;,&apos;sqp&apos;);
    x = fmincon(fun,x0,A_ineq,b_ineq,[],[],lb,ub,[],opts);

    %% Export Solution
    u1 = x(1);
    u2 = x(2);
    u3 = x(3);
    u4 = x(4);
end</P>
      </eml>
    </state>
    <data SSID="4" name="F">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[1 4]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="u">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="omega">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[1 4]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
