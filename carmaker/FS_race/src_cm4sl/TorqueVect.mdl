<chart id="57">
  <P Name="name">CarMaker/IPG Vehicle/PowerTrain/PTControl Example/PTControl_TV_MFE3/Full Control Loop/Reference Generator/Y_Reference</P>
  <P Name="windowPosition">[563 52 198 683]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">57</P>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Y_Reference</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">57</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [y_ref1,y_ref2, y_ref3, y_ref4] = Y_Reference( target_kappa,  vehicle_speed,min_speed)

%min_speed = 0.1;
y_ref = ones(4,1).*target_kappa;

if vehicle_speed &lt;= min_speed %arbirtary, just need something otherwise car won&apos;t start. Should look into its impact
    for i = 1:4
        y_ref(i) = min_speed*target_kappa(i);
        disp(vehicle_speed)
    end

else
    for i = 1:4
        y_ref(i) = vehicle_speed*target_kappa(i);
        disp(vehicle_speed)
    end
end
y_ref1=y_ref(1);
y_ref2=y_ref(2);
y_ref3=y_ref(3);
y_ref4=y_ref(4);</P>
      </eml>
    </state>
    <data SSID="6" name="target_kappa">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="vehicle_speed">
