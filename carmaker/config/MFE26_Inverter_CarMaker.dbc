 SG_ ASCallowed : 2|1@1+ (1,0) [0|1] "" SpeedgoatHIL
 SG_ CurrentControl : 3|1@1+ (1,0) [0|1] "" SpeedgoatHIL
 SG_ SpeedSetpoint : 16|16@1- (1,0) [-32768|32767] "RPM" SpeedgoatHIL
